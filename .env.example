# Copy to .env and change the passwords before any real deployment.
# docker compose reads this file automatically.

# Database (shared by the moodle and db services)
DB_TYPE=mariadb
DB_NAME=moodle
DB_USER=moodle
DB_PASS=change-me
DB_ROOT_PASS=change-me-too

# Public URL of the Moodle site (must match how users reach it)
MOODLE_URL=http://localhost:8080
